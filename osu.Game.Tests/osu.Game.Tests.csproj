<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\osu.TestProject.props" />
  <ItemGroup Label="Package References">
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="Nito.AsyncEx" Version="5.1.2" />
    <PackageReference Include="NUnit" Version="4.5.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>
  <PropertyGroup Label="Project">
    <OutputType>WinExe</OutputType>
    <!-- torii nova: net8.0 para matchear osu.Game (nova es .NET 10). upstream/master usa net8.0. -->
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup Label="Code Analysis">
    <GlobalAnalyzerConfigFiles Include="CodeAnalysis.tests.globalconfig" />
  </ItemGroup>
  <ItemGroup Label="Project References">
    <ProjectReference Include="..\osu.Game.Rulesets.Osu\osu.Game.Rulesets.Osu.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Catch\osu.Game.Rulesets.Catch.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Mania\osu.Game.Rulesets.Mania.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Taiko\osu.Game.Rulesets.Taiko.csproj" />
  </ItemGroup>
  <ItemGroup Label="torii nova: tests stale de difficulty-calculator">
    <!-- estos 3 tests overridean la API vieja de DifficultyCalculator (con el param clockRate)
         que la osu.Game de nova ya no tiene; quedaron sin actualizar en el fork. Los excluimos
         del compile para que el visual test browser (donde viven los test scenes de ranked play)
         pueda buildear. No corren en nova de todas formas. -->
    <Compile Remove="NonVisual\DifficultyAdjustmentModCombinationsTest.cs" />
    <Compile Remove="NonVisual\TestSceneTimedDifficultyCalculation.cs" />
    <Compile Remove="Visual\UserInterface\TestSceneBeatmapAttributeText.cs" />
    <!-- usa ReleaseStream.Lazer/Tachyon (upstream); Torii tiene su propio enum de streams. -->
    <Compile Remove="NonVisual\TestSceneUpdateManager.cs" />
  </ItemGroup>
</Project>
