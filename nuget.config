<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Increase timeout to 15 minutes (900 seconds) -->
    <add key="http.timeout" value="900000" />
    <!-- Enable package restore -->
    <add key="packageRestore" value="true" />
    <!-- Retry failed downloads more times -->
    <add key="retrycount" value="5" />
    <!-- Reduce parallel downloads to avoid overwhelming the connection -->
    <add key="maxHttpRequestsPerSource" value="8" />
    <!-- Add delay between retries -->
    <add key="retryDelayInMilliseconds" value="2000" />
  </config>
  
  <packageSources>
    <clear />
    <!--
      Local Torii.Veldrid feed. The framework references
      `Torii.Veldrid 4.9.X-g...` which is NOT published to nuget.org —
      CI clones torii-veldrid as a sibling and `dotnet pack`s it into
      `bin/Packages/Release/` (see build-gu.yml + ci.yml). This source
      tells NuGet to look there first. Listed before nuget.org so the
      local feed wins over any stale cache.
    -->
    <add key="torii-veldrid-local" value="..\torii-veldrid\bin\Packages\Release" />
    <!-- Primary NuGet source -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/GooGuTeam/index.json" />
  </packageSources>
  
  <bindingRedirects>
    <add key="skip" value="False" />
  </bindingRedirects>
</configuration> 