<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Increase timeout to 15 minutes (900 seconds) -->
    <add key="http.timeout" value="900000" />
    <!-- Enable package restore -->
    <add key="packageRestore" value="true" />
    <!-- Retry failed downloads more times -->
    <add key="retrycount" value="5" />
    <!-- Reduce parallel downloads to avoid overwhelming the connection -->
    <add key="maxHttpRequestsPerSource" value="8" />
    <!-- Add delay between retries -->
    <add key="retryDelayInMilliseconds" value="2000" />
  </config>

  <packageSources>
    <clear />
    <!--
      Vanilla is pure upstream lazer against the STOCK ppy.osu.Framework
      published on nuget.org (see osu.Game.csproj, ppy.osu.Framework
      2026.629.0). No local Torii.Veldrid feed and no ProjectReference to a
      sibling framework, so nuget.org is the only source we need. Keeping a
      single explicit source means CI restores (which pass this file via the
      configfile flag) resolve the exact stock framework and nothing shadows it.
    -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <bindingRedirects>
    <add key="skip" value="False" />
  </bindingRedirects>
</configuration>
