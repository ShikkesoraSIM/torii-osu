<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Torii Cosmetic Creator — arma cursores/auras/trails para Torii sin codear.</Description>
    <AssemblyName>torii-cosmetic-creator</AssemblyName>
    <AssemblyTitle>Torii Cosmetic Creator</AssemblyTitle>
    <Title>Torii Cosmetic Creator</Title>
    <Product>Torii Cosmetic Creator</Product>
    <Version>0.0.0</Version>
    <FileVersion>0.0.0</FileVersion>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <StartupObject>Torii.CosmeticCreator.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup Label="Project References">
    <!-- referencia el juego para reusar el runtime data-driven de cosmeticos + todo el toolkit UI
         de osu (fonts, OsuColour, Form/Settings controls) + arrancar como app osu-flavored standalone
         (mismo patron que el tournament client). traemos los rulesets para que el OsuGameBase no se
         queje al inicializar el RulesetStore. -->
    <ProjectReference Include="..\osu.Game\osu.Game.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Osu\osu.Game.Rulesets.Osu.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Catch\osu.Game.Rulesets.Catch.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Mania\osu.Game.Rulesets.Mania.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Taiko\osu.Game.Rulesets.Taiko.csproj" />
  </ItemGroup>
  <ItemGroup Label="Sample auras">
    <!-- auras de ejemplo (bases para "empezar de" y para el round-trip verify). se copian al lado del
         exe para que el editor las cargue desde AppContext.BaseDirectory/SampleAuras. -->
    <None Include="SampleAuras\*.toriicosmetic">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
