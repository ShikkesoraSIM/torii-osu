<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\osu.Android.props" />
  <PropertyGroup>
    <!-- android se queda en net10.0-android (CoreCLR): el framework solo publica
         osu.Framework.Android para net10.0-android, y net8.0-android esta EOL
         (NETSDK1202). el objetivo "net8 estable" es para DESKTOP, donde estaban
         los hiccups de GC; android es un runtime mobile aparte. osu.Game (net8.0)
         es compatible-hacia-abajo con la app net10.0-android. -->
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>osu.Android</RootNamespace>
    <AssemblyName>osu.Android</AssemblyName>
    <Version>0.0.0</Version>
    <ApplicationVersion Condition=" '$(ApplicationVersion)' == '' ">1</ApplicationVersion>
    <ApplicationDisplayVersion Condition=" '$(ApplicationDisplayVersion)' == '' ">$(Version)</ApplicationDisplayVersion>

    <!-- Run on CoreCLR instead of Mono. .NET 10 enables CoreCLR for Android;
         on arm64 this is ~3x faster on tight inner loops (difficulty calc +
         audio mixer), and uses the same JIT as the desktop builds. -->
    <UseMonoRuntime>false</UseMonoRuntime>

    <!-- Disable ReadyToRun: there is no R2R compiler for android-arm64 in
         .NET 10 yet. Without this the publish fails with NETSDK1094
         ("a valid runtime package was not found"). The CoreCLR JIT still runs
         at full speed; only the marginal cold-start R2R benefit is lost. -->
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Android application properties (match proven Torii Nova branding). -->
    <ApplicationId>sh.shikkesora.torii</ApplicationId>
    <ApplicationTitle>Torii Nova</ApplicationTitle>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\osu.Game.Rulesets.Catch\osu.Game.Rulesets.Catch.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Mania\osu.Game.Rulesets.Mania.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Osu\osu.Game.Rulesets.Osu.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Taiko\osu.Game.Rulesets.Taiko.csproj" />
    <ProjectReference Include="..\osu.Game\osu.Game.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Essentials" Version="8.0.3" />
  </ItemGroup>
</Project>
