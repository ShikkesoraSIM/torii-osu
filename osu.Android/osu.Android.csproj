<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\osu.Android.props" />
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>osu.Android</RootNamespace>
    <AssemblyName>osu.Android</AssemblyName>
    <Version>0.0.0</Version>
    <ApplicationVersion Condition=" '$(ApplicationVersion)' == '' ">1</ApplicationVersion>
    <ApplicationDisplayVersion Condition=" '$(ApplicationDisplayVersion)' == '' ">$(Version)</ApplicationDisplayVersion>

    <!-- Run on CoreCLR instead of Mono. .NET 10 enables CoreCLR for
         Android; for arm64 devices this is roughly 3x faster on
         tight inner loops (the difficulty calculator + audio mixer
         are the immediate beneficiaries). Combined with the arm64-only
         RuntimeIdentifiers in osu.Android.props, this cuts the APK
         size and replaces the legacy interpreter with the same JIT
         the desktop builds use. -->
    <UseMonoRuntime>false</UseMonoRuntime>

    <!-- Disable ReadyToRun: there's no R2R compiler shipped for
         android-arm64 yet (CoreCLR-on-Android is experimental in .NET
         10, the AOT/R2R toolchain hasn't caught up). Without this
         override the publish step errors out with NETSDK1094 ("Unable
         to optimize assemblies for performance: a valid runtime
         package was not found"). The CoreCLR JIT still runs at full
         speed at app startup, so we just lose the marginal cold-start
         advantage R2R would have given. -->
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Android application properties -->
    <ApplicationId>sh.shikkesora.torii</ApplicationId>
    <ApplicationTitle>Torii Nova</ApplicationTitle>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Remove="Resources\values\styles.xml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\osu.Game.Rulesets.Catch\osu.Game.Rulesets.Catch.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Mania\osu.Game.Rulesets.Mania.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Osu\osu.Game.Rulesets.Osu.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Taiko\osu.Game.Rulesets.Taiko.csproj" />
    <ProjectReference Include="..\osu.Game\osu.Game.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AndroidResource Include="Resources\values\styles.xml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Essentials" Version="8.0.3" />
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.6.1.7" />
  </ItemGroup>
</Project>
